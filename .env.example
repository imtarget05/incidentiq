# Copy this file to .env and fill in your values. Never commit .env.

# Cloudflare (set via `wrangler secret put` for production, never in git)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token   # for deployment only

# D1
D1_DATABASE_ID=your_d1_database_id
D1_DATABASE_NAME=ai-knowledge-platform

# Vectorize (bound by index NAME in wrangler.toml — no index id required)
VECTORIZE_INDEX_NAME=ai-knowledge-vectors

# Optional: public URL of the deployed API worker (enables MCP deploy + smoke test)
API_WORKER_URL=https://ai-knowledge-platform.your-subdomain.workers.dev

# ETL execution mode: inline (default) or queue (needs the ai-knowledge-etl worker)
ETL_MODE=inline

# MCP (OAuth)
MCP_BASE_URL=https://your-mcp-worker.your-subdomain.workers.dev
MCP_CLIENT_ID=your_mcp_client_id
MCP_CLIENT_SECRET=your_mcp_client_secret

# Limits (Free-tier guardrails)
MAX_DOCUMENTS_PER_TENANT=50
MAX_DOCUMENT_SIZE_MB=1
MAX_QUESTIONS_PER_DAY=100
MAX_TOKENS_PER_ANSWER=512
MAX_CHUNK_CHARS=800
MAX_CHUNKS_PER_DOCUMENT=25
TOP_K=5

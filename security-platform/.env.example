# security-platform environment variables
# Copy this file to .env and fill in real values before running locally.
# Never commit real credentials.

DATABASE_URL=postgresql://security:security@localhost:5432/security_dashboard

# API key used by clients to authenticate (X-Api-Key header).
# Store only the SHA-256 hash of this value in the database.
API_KEY=your_live_api_key_here

PORT=8000
